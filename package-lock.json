{
  "name": "benchmark",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "benchmark",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@benchmark/benchmark": {
      "resolved": "packages/benchmark",
      "link": true
    },
    "node_modules/@benchmark/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@benchmark/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/benchmark": {
      "name": "@benchmark/benchmark",
      "version": "0.1.0"
    },
    "packages/core": {
      "name": "@benchmark/core",
      "version": "0.1.0"
    },
    "packages/shared": {
      "name": "@benchmark/shared",
      "version": "0.1.0"
    }
  }
}

{
  "name": "benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ninety-second expert elicitation on ACAPS risk statements, with intervals and a dissent loop.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test packages/shared/core.test.js packages/*/test/*.test.js",
    "backtest": "node scripts/backtest.mjs",
    "gate:export": "node scripts/gate-export.mjs",
    "verify": "node scripts/verify.mjs",
    "test:core": "node --test packages/shared/core.test.js",
    "gate:privacy": "node scripts/gate-privacy.mjs",
    "baseline": "node scripts/measure-baseline.mjs",
    "fit": "node scripts/fit-baseline.mjs",
    "ladder": "node scripts/measure-baseline.mjs && node scripts/fit-baseline.mjs",
    "check:method": "node scripts/check-methodology.mjs",
    "gate:numbers": "node scripts/numbers-gate.mjs",
    "check:spine": "node scripts/check-spine.mjs",
    "gate:anonymity": "node scripts/gate-anonymity.mjs",
    "serve": "node packages/service/bin/serve.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.public.json",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=moderate",
    "worklist": "node scripts/authoring-worklist.mjs",
    "label": "node scripts/label-observable.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "minimatch": ">=11.0.1"
  }
}

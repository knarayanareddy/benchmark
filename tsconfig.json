{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/core/src/**/*.js",
    "packages/benchmark/src/**/*.js",
    "packages/service/src/**/*.js",
    "packages/service/bin/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.js",
    "packages/shared"
  ]
}

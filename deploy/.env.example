# Copy to deploy/.env and fill in EVERY value. Never commit the real file (.env is git-ignored).
DOMAIN=ground-truth.example.org

# Three database passwords. The service never gets the owner password.
OWNER_DB_PASSWORD=
ROSTER_DB_PASSWORD=
ANSWERS_DB_PASSWORD=

# Two different secrets, >= 16 characters each. `openssl rand -base64 32` is fine.
# Keep copies somewhere that is NOT the database or its backups: losing the ballot secret
# means anonymous answers can no longer be matched to their authors for export or erase.
BENCHMARK_BALLOT_SECRET=
BENCHMARK_ALIAS_SECRET=

# Optional: device-held ballots (an anonymous expert's key never leaves their phone).
#   node packages/service/bin/blind-keygen.mjs > deploy/secrets/blind-key.pem
# Optional: the two-moderator safety override. The service gets only the PUBLIC half;
# keep the private half OFFLINE with the moderators who may approve an opening.
#   node packages/service/bin/breakglass-keygen.mjs > breakglass.pem   (split it; publish only the public key)
# Mount the files into the app container (see docker-compose.yml) and name them here.
BLIND_KEY_FILE=
BREAKGLASS_PUBLIC_KEY_FILE=

# Staff sign-in (any OpenID Connect provider). The redirect URI is built from DOMAIN.
OIDC_ISSUER=https://login.example.org
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# email:role pairs; role is analyst or moderator
STAFF_ROLES=moderator@example.org:moderator,analyst@example.org:analyst
